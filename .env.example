# Copy to .env at repo root for docker-compose, and see apps/api/.env.example
# for Laravel-specific configuration.

COMPOSE_PROJECT_NAME=obscurify

# --- Postgres ---
POSTGRES_DB=obscurify
POSTGRES_USER=obscurify
POSTGRES_PASSWORD=obscurify
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6380

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=obscurify
MINIO_ROOT_PASSWORD=obscurify_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=obscurify

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- nginx / api ---
NGINX_PORT=8080
