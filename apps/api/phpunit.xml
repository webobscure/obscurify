<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- `php artisan test` spawns the actual test run as a child
             process that does not inherit CLI `-d` flags passed to the
             outer `artisan` invocation — setting it here (applied via
             ini_set() from inside the test process itself) is what
             actually reaches the run, regardless of how it was
             launched. Without it, `php artisan test` exhausts PHP's
             default 128M loading routes/api.php (a genuinely large
             route file) before a single test executes; `vendor/bin/pest`
             run directly with `-d memory_limit=1G` was unaffected since
             there's no artisan subprocess boundary in that path. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <!-- Deliberately pinned to en regardless of production's APP_LOCALE
             (ru — spec: "Russian must become the default language for the
             entire platform") so the bulk of the existing suite keeps
             asserting stable, deterministic message text. Localization
             itself is verified by dedicated tests that explicitly switch
             locale per-test — see docs/architecture/localization.md and
             tests/Feature/Localization/. -->
        <env name="APP_LOCALE" value="en"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="obscurify_test"/>
        <env name="DB_USERNAME" value="obscurify"/>
        <env name="DB_PASSWORD" value="obscurify"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="PAYMENTS_FAKE_SECRET" value="testing-fake-payment-secret"/>
        <env name="SHIPPING_FAKE_SECRET" value="testing-fake-shipping-secret"/>
        <env name="RUSSIAN_COMMERCE_FAKE_FISCALIZATION_SECRET" value="testing-fake-fiscalization-secret"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
