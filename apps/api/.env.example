APP_NAME=Obscurify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=obscurify
DB_USERNAME=obscurify
DB_PASSWORD=obscurify

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=obscurify_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,127.0.0.1:3000,127.0.0.1:3001

# Explicit, real origins only — e.g. https://admin.example.com. Never "*":
# CORS credentials are on (storefront guest cart cookie), and a wildcard
# origin combined with credentials reflects the caller's Origin header
# back rather than actually restricting anything (AppServiceProvider
# refuses to boot if this is ever "*"). Local dev doesn't need this set —
# config/cors.php already allows any *.localhost:PORT origin.
CORS_ALLOWED_ORIGINS=

# Gates the entire fake payment surface (see config/payments.php) —
# defaults on for APP_ENV=local/testing, off otherwise. PAYMENTS_FAKE_SECRET
# has no default; the app refuses to boot with the fake provider enabled
# and no secret set, since that secret is what verifies simulated webhooks.
PAYMENTS_FAKE_SECRET=local-dev-fake-payment-secret-do-not-use-in-shared-envs

# Same pattern as PAYMENTS_FAKE_SECRET above, for the fake shipping
# provider (see config/commerce.php's shipping.fake).
SHIPPING_FAKE_SECRET=local-dev-fake-shipping-secret-do-not-use-in-shared-envs

# Same pattern as PAYMENTS_FAKE_SECRET above, for FakeFiscalizationProvider
# (see config/russian_commerce.php).
RUSSIAN_COMMERCE_FAKE_FISCALIZATION_SECRET=local-dev-fake-fiscalization-secret-do-not-use-in-shared-envs

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@obscurify.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=obscurify
AWS_SECRET_ACCESS_KEY=obscurify_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=obscurify
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
